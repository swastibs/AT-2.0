# Application
NODE_ENV=development
PORT=5000
PROJECT_NAME=AtomicTask
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/atomictask

# JWT
JWT_SECRET=replace_with_secure_jwt_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
SESSION_COOKIE_NAME=refreshToken

# Redis
REDIS_URL=

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@atomictask.local

# Logging
LOG_LEVEL=info

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=3

# Optional proxy config
TRUST_PROXY=1
